{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/mathhist-toolkit/spec/framework/graph.schema.json",
  "title": "mathhist graph bundle v0.2",
  "description": "图包：nodes 复用 object-model.schema.json，edges 由本文件约束。人读规范见 spec/object-model.md §5。JSON Schema 只能校验单条边的形状；端点是否存在、类型是否匹配、是否成环、权重是否归一等跨对象约束需由校验脚本执行（§5.6）。 边 type 枚举与 if/then 条件约束由 spec/framework/edge-signatures.yaml 生成（tools/graphlint generate），勿手改。",
  "type": "object",
  "required": [
    "schema_version",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "./object-model.schema.json"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "time": {
      "type": "object",
      "required": [
        "from",
        "to",
        "precision"
      ],
      "properties": {
        "from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "to": {
          "type": [
            "integer",
            "null"
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "year",
            "decade",
            "century",
            "circa",
            "traditional",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "from": {
                "type": "null"
              },
              "to": {
                "type": "null"
              }
            },
            "required": [
              "from",
              "to"
            ]
          },
          "then": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "locator"
      ],
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^TX:[a-z0-9][a-z0-9.-]*$"
        },
        "witness": {
          "type": "string",
          "pattern": "^TW:[a-z0-9][a-z0-9.-]*$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^(https?://|ark:/|DOI:)"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "type",
        "directed"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E:[^>]+>[a-z_]+>[^>]+(#[0-9]+)?$"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "parent_of",
            "cross_class",
            "prerequisite_of",
            "concerns",
            "generalizes",
            "depends_on",
            "resolves",
            "reformulates",
            "spawned",
            "poses",
            "asserted_by",
            "about",
            "claimed_in",
            "contradicts",
            "competes_with",
            "denotes",
            "supersedes",
            "uses_notation",
            "uses_method",
            "targets",
            "corrected_by",
            "contributed_to",
            "proved",
            "introduced",
            "participates_in",
            "part_of",
            "witness_of",
            "derived_from",
            "supports",
            "anchors",
            "member_of",
            "employed_by",
            "publishes_in",
            "published_in",
            "resembles",
            "exemplifies"
          ]
        },
        "directed": {
          "type": "boolean"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "claimant": {
          "type": [
            "string",
            "null"
          ]
        },
        "grade": {
          "enum": [
            "A",
            "S",
            "U",
            "F"
          ]
        },
        "attestation": {
          "enum": [
            "direct",
            "contemporary_report",
            "later_report",
            "textbook_simplification",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "kind": {
          "enum": [
            "taxonomic",
            "historical",
            "institutional",
            "overlaps",
            "prerequisite",
            "method_source",
            "shared_object",
            null
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^doc:.+#.+$"
        },
        "note": {
          "type": "string",
          "maxLength": 280
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CLM:[A-Za-z0-9:._-]+\\.[0-9]+$"
          }
        },
        "skeleton_kind": {
          "enum": [
            "direct",
            "contradiction",
            "construction",
            "induction",
            "descent",
            "exhaustion",
            "algebraic_identity",
            "case_split",
            "extremal",
            "limit",
            "other"
          ]
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "conclusion_match": {
          "type": "boolean"
        },
        "specificity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trace_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^doc:.+#.+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "parent_of"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "directed": {
                "const": true
              },
              "from": {
                "pattern": "^BR-[A-Z0-9-]+$"
              },
              "to": {
                "pattern": "^BR-[A-Z0-9-]+$"
              },
              "kind": {
                "enum": [
                  "taxonomic",
                  "historical",
                  "institutional"
                ]
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "kind",
              "weight"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cross_class"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "directed": {
                "const": true
              },
              "from": {
                "pattern": "^BR-[A-Z0-9-]+$"
              },
              "to": {
                "pattern": "^BR-[A-Z0-9-]+$"
              },
              "kind": {
                "enum": [
                  "overlaps",
                  "prerequisite",
                  "method_source",
