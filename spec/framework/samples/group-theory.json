      "labels": { "zh": "阿贝尔–鲁菲尼定理", "en": "Abel–Ruffini theorem" },
      "status": "active",
      "summary": "一般五次及以上方程无根式解。",
      "statement": "次数 ≥5 的一般方程不能用根式求解。",
      "assumptions": ["特征 0 域", "一般方程指系数为未定元"],
      "proof_status": "proved",
      "namesake_note": "鲁菲尼 1799 先发表但有缺口；阿贝尔 1824 给出完整证明；'阿贝尔–鲁菲尼'是后世合并命名。",
      "claims": [
        {
          "id": "CLM:TH:abel-ruffini.1",
          "statement": "阿贝尔 1824 证明一般五次方程无根式解；鲁菲尼 1799 的证明存在缺口。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Wussing 1969, ch.2（章节级；页码待补）" }
        }
      ],
