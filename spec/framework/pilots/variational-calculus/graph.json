    {
      "id": "CO:first-variation",
      "type": "concept",
      "schema_version": "0.2",
      "labels": { "zh": "一阶变分", "en": "first variation" },
      "status": "active",
      "summary": "泛函在容许曲线微小扰动下的一阶改变量；其为零是极值的必要条件。",
      "definition": "对泛函 J[y]，若 y 为极值曲线，则对任意容许变分 η 有 δJ[y;η] = 0。",
      "definition_source": { "grade": "F", "locator": "通行教材定义；定义本身不是历史对象" },
      "occurrences": [
        { "civilization": "欧洲", "region": "瑞士", "language": "la", "year_from": 1744, "precision": "year", "dating_basis": "欧拉《求极大极小的新方法》", "independence": "independent" }
      ],
      "claims": [
        {
          "id": "CLM:CO:first-variation.1",
          "statement": "把极值条件写成变分为零，是 18 世纪变分法成型的关键一步，欧拉 1744 年的著作是标志性文本。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Euler 1744, Methodus inveniendi lineas curvas；据通行数学史转述" }
        }
      ],
      "provenance": { "created_by": "branch-expansion-batch1", "created_at": "2026-11-25", "sources_checked": "partial", "schema_version": "0.2" }
    },
    {
      "id": "TH:euler-lagrange-equation",
      "type": "theorem",
      "schema_version": "0.2",
      "labels": { "zh": "欧拉–拉格朗日方程", "en": "Euler–Lagrange equation" },
      "status": "active",
      "summary": "泛函极值曲线必须满足的二阶常微分方程；变分法的核心判据。",
      "statement": "若 J[y] = ∫ L(x, y, y′) dx 在 y 处取极值，则 ∂L/∂y − d/dx(∂L/∂y′) = 0。",
      "assumptions": ["L 充分光滑", "y 在端点固定", "容许曲线足够光滑"],
      "proof_status": "proved",
      "namesake_note": "欧拉 1744 年给出几何形式，拉格朗日 1760 年代给出解析形式；双名是后世合并。",
      "claims": [
        {
          "id": "CLM:TH:euler-lagrange-equation.1",
          "statement": "欧拉 1744 年与拉格朗日 1760 年代先后给出该方程；'欧拉–拉格朗日'是合并命名。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Euler 1744；Lagrange 1760–61, Essai d'une nouvelle méthode；据通行数学史转述" }
        }
      ],
      "provenance": { "created_by": "branch-expansion-batch1", "created_at": "2026-11-25", "sources_checked": "partial", "schema_version": "0.2" }
    },
