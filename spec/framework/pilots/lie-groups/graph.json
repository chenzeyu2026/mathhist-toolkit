    {
      "id": "TH:lie-fundamental-theorems",
      "type": "theorem",
      "schema_version": "0.2",
      "labels": { "zh": "李的三基本定理", "en": "Lie's three fundamental theorems" },
      "status": "active",
      "summary": "局部李群由其李代数决定；结构常数满足反对称与雅可比，且可实现为局部群。",
      "statement": "局部李群的结构由单位元处的李代数决定；李代数的结构常数满足反对称性与雅可比恒等式，并在局部可实现为变换群。",
      "assumptions": ["局部李群", "有限维", "实或复系数"],
      "proof_status": "proved",
      "namesake_note": "三条定理的编号与表述在不同文献中略有差异；此处取'局部群↔李代数'的合并表述。",
      "claims": [
        {
          "id": "CLM:TH:lie-fundamental-theorems.1",
          "statement": "李的三基本定理建立了局部李群与其李代数之间的对应，是李群理论的结构基础。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Lie 1888–1893, Theorie der Transformationsgruppen；据通行教材与数学史转述" }
        }
      ],
      "provenance": { "created_by": "branch-expansion-batch2", "created_at": "2026-11-25", "sources_checked": "partial", "schema_version": "0.2" }
    },
    {
      "id": "TH:cartan-classification",
      "type": "theorem",
      "schema_version": "0.2",
      "labels": { "zh": "复半单李代数的分类", "en": "classification of complex semisimple Lie algebras" },
      "status": "active",
      "summary": "复半单李代数由根系（Dynkin 图的前身）分类，归结为 A–G 型。",
      "statement": "复半单李代数可分解为单理想的直和，单理想由根系分类，对应 A_n、B_n、C_n、D_n 与例外型 E、F、G。",
      "assumptions": ["复系数", "有限维", "半单"],
      "proof_status": "proved",
      "namesake_note": "Killing 1888–1890 给出根系与分类雏形，Cartan 1894 学位论文完成分类；Dynkin 图是 1947 年后的表述。",
      "claims": [
        {
          "id": "CLM:TH:cartan-classification.1",
          "statement": "Killing 在 1888–1890 年引入根系并给出分类雏形，Cartan 1894 年学位论文完成复半单李代数分类。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Killing 1888–1890, Math. Ann.；Cartan 1894 学位论文；据通行数学史转述" }
        }
      ],
      "provenance": { "created_by": "branch-expansion-batch2", "created_at": "2026-11-25", "sources_checked": "partial", "schema_version": "0.2" }
    },
