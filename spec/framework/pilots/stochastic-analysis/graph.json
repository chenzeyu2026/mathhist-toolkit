    {
      "id": "TH:ito-formula",
      "type": "theorem",
      "schema_version": "0.2",
      "labels": { "zh": "Itô 公式", "en": "Itô's formula" },
      "status": "active",
      "summary": "随机过程复合函数的链式法则，比经典链式法则多出二阶变差项。",
      "statement": "若 X_t 满足 dX = μ dt + σ dB，f 光滑，则 df(X_t) = f′ dX + ½ f″ σ² dt。",
      "assumptions": ["X 为 Itô 过程", "f 二阶连续可微", "积分按 Itô 意义"],
      "proof_status": "proved",
      "namesake_note": "1944 年论文给出积分；1951 年论文给出微分公式的完整表述。",
      "claims": [
        {
          "id": "CLM:TH:ito-formula.1",
          "statement": "Itô 1951 年论文给出随机微分与复合函数公式，后称 Itô 公式。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Itô 1951, On a formula concerning stochastic differentials, Nagoya Math. J. 3, 55–65" }
        }
      ],
      "provenance": { "created_by": "branch-expansion-batch2", "created_at": "2026-11-25", "sources_checked": "partial", "schema_version": "0.2" }
    },
