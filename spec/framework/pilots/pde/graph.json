    {
      "id": "TH:d-alembert-wave-solution",
      "type": "theorem",
      "schema_version": "0.2",
      "labels": { "zh": "达朗贝尔弦振动通解", "en": "d'Alembert's solution of the wave equation" },
      "status": "active",
      "summary": "一维波动方程的通解可写成两个沿相反方向传播的任意函数之和。",
      "statement": "u(x,t) = f(x − ct) + g(x + ct)，f、g 由初始位移与初速度确定。",
      "assumptions": ["均匀弦", "小振幅振动", "无外力", "一维"],
      "proof_status": "proved",
      "namesake_note": "'达朗贝尔解'是后世命名；1747 年论文的处理对象是具体弦振动。",
      "claims": [
        {
          "id": "CLM:TH:d-alembert-wave-solution.1",
          "statement": "达朗贝尔 1747 年给出弦振动方程的通解形式，即两个任意函数之和。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "d'Alembert 1747；据 DSB 条目转述，未见原刊" }
        }
      ],
      "provenance": { "created_by": "branch-expansion-batch1", "created_at": "2026-11-25", "sources_checked": "partial", "schema_version": "0.2" }
    },
    {
      "id": "TH:fourier-heat-series",
      "type": "theorem",
      "schema_version": "0.2",
      "labels": { "zh": "热传导方程的三角级数解", "en": "trigonometric series solution of the heat equation" },
      "status": "active",
      "summary": "在齐次边界条件下，热传导方程的解可展开为三角级数；收敛性的严格证明晚于傅里叶。",
      "statement": "满足齐次边界条件的热传导方程解可写成 Σ b_n sin(nπx/L) e^{−α(nπ/L)²t} 的形式。",
      "assumptions": ["均匀杆", "齐次边界条件", "初始温度分段连续"],
      "proof_status": "proved",
      "namesake_note": "傅里叶 1822 年系统使用；级数收敛性的严格化由 Dirichlet 等人在 19 世纪完成。",
      "claims": [
        {
          "id": "CLM:TH:fourier-heat-series.1",
          "statement": "傅里叶 1822 年用三角级数表示热传导方程的解；收敛性证明是后续工作。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Fourier 1822, Théorie analytique de la chaleur；据 DSB 条目转述" }
        }
      ],
      "provenance": { "created_by": "branch-expansion-batch1", "created_at": "2026-11-25", "sources_checked": "partial", "schema_version": "0.2" }
    },
