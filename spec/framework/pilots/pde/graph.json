      ],
      "claims": [
        {
          "id": "CLM:CO:wave-equation.1",
          "statement": "18 世纪的弦振动研究以具体弦的位移为对象，'波动方程'作为一般方程名是后世写法。",
          "grade": "U",
          "attestation": "later_report",
          "source": { "locator": "据通行数学史教材转述；原始论文页未核" },
