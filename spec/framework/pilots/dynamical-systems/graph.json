    },
    {
      "id": "PR:stability-of-motion",
      "type": "problem",
      "schema_version": "0.2",
      "labels": { "zh": "运动稳定性问题", "en": "stability of motion" },
      "status": "resolved",
      "summary": "判断平衡点或周期轨在初始扰动下是否保持邻近；李雅普诺夫 1892 年给出一般判据。",
      "original_formulation": {
        "text": "给定微分方程组的平衡解，判断初始扰动足够小时解是否始终保持在平衡解附近。",
        "language": "ru",
        "author": "PE:lyapunov",
        "year": 1892,
        "source": { "locator": "Lyapunov 1892, The General Problem of the Stability of Motion（俄文，哈尔科夫）", "grade": "S", "attestation": "later_report" },
        "grade": "S",
        "attestation": "later_report"
      },
      "problem_kind": "other",
      "asked_as": ["平衡点稳不稳", "扰动会不会放大"],
      "related_branches": ["BR-ANA-DYN"],
      "claims": [],
      "provenance": { "created_by": "branch-expansion-batch1", "created_at": "2026-11-25", "sources_checked": "partial", "schema_version": "0.2" }
    },
    {
      "id": "TH:lyapunov-stability",
      "type": "theorem",
      "schema_version": "0.2",
      "labels": { "zh": "李雅普诺夫稳定性判据", "en": "Lyapunov stability criterion" },
      "status": "active",
      "summary": "用正定函数沿轨线的导数符号判断平衡点稳定性；无需解出方程。",
      "statement": "若在平衡点邻域存在正定连续可微函数 V，且 V 沿轨线的导数负半定，则平衡点稳定；若负定，则渐近稳定。",
      "assumptions": ["平衡点邻域内向量场充分光滑", "V 正定", "V 沿轨线可微"],
      "proof_status": "proved",
      "namesake_note": "李雅普诺夫 1892 年提出；'直接法'是后世的称法。",
      "claims": [
        {
          "id": "CLM:TH:lyapunov-stability.1",
          "statement": "李雅普诺夫 1892 年学位论文给出不使用显式解的稳定性判据，后称李雅普诺夫直接法。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Lyapunov 1892；据 DSB 'Lyapunov' 条目与通行教材转述" }
        }
      ],
      "provenance": { "created_by": "branch-expansion-batch1", "created_at": "2026-11-25", "sources_checked": "partial", "schema_version": "0.2" }
    },
    {
      "id": "CO:phase-space",
      "type": "concept",
      "schema_version": "0.2",
      "labels": { "zh": "相空间", "en": "phase space" },
      "status": "active",
      "summary": "以位置与动量为坐标、把系统状态表示为一点的空间；轨线表示演化。",
      "definition": "对 n 自由度系统，以 (q, p) 为坐标的 2n 维空间；每条轨线对应一组运动。",
      "definition_source": { "grade": "F", "locator": "通行教材定义；定义本身不是历史对象" },
      "occurrences": [
        { "civilization": "欧洲", "region": "法国", "language": "fr", "year_from": 1890, "precision": "decade", "dating_basis": "庞加莱三体问题论文中的相空间表述", "independence": "independent" }
      ],
      "claims": [
        {
          "id": "CLM:CO:phase-space.1",
          "statement": "庞加莱在三体问题研究中用相空间中的轨线与截面讨论解的定性行为；'相空间'一词由吉布斯 1902 年确立。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Poincaré 1890；Gibbs 1902, Elementary Principles in Statistical Mechanics；页码待补" }
        }
      ],
