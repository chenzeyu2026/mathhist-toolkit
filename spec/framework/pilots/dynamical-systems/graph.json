    {
      "id": "PR:three-body-problem",
      "type": "problem",
      "schema_version": "0.2",
      "labels": { "zh": "三体问题", "en": "three-body problem" },
      "status": "partially_resolved",
      "summary": "三个质点仅在万有引力下运动的轨道问题；庞加莱 1890 年证明一般情形不可积。",
      "original_formulation": {
        "text": "给定三个质点的初始位置与速度，求此后运动；等价于求足够多的运动积分。",
        "language": "fr",
        "author": "PE:poincare",
        "year": 1890,
        "source": { "locator": "Poincaré 1890, Sur le problème des trois corps et les équations de la dynamique, Acta Mathematica 13", "grade": "S", "attestation": "later_report" },
        "grade": "S",
        "attestation": "later_report"
      },
      "problem_kind": "existence",
      "asked_as": ["求三体运动的显式解", "求运动积分"],
      "related_branches": ["BR-ANA-DYN"],
      "claims": [
        {
          "id": "CLM:PR:three-body-problem.1",
          "statement": "庞加莱 1890 年的三体问题论文证明该问题一般不可积，并发现同宿缠绕，被视为动力系统与混沌研究的起点之一。",
          "grade": "S",
          "attestation": "later_report",
          "source": { "locator": "Poincaré 1890, Acta Mathematica 13；据 DSB 条目与通行数学史转述，未见原刊" }
        }
      ],
