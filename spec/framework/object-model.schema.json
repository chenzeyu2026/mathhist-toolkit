{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/mathhist-toolkit/spec/framework/object-model.schema.json",
  "title": "mathhist object model v0.2",
  "description": "单条节点记录的信封与类型约束。人读规范见 spec/object-model.md；本文件只校验结构，不校验史学判断。关系不在此文件，见 graph.schema.json。",
  "type": "object",
  "required": ["id", "type", "schema_version", "labels", "status", "claims", "provenance"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^(BR-[A-Z0-9-]+|(CO|TH|PR|ME|TY|FA|NO|PE|TX|TW|EV|TP|ST):[a-z0-9][a-z0-9.-]*)$" },
    "type": { "enum": ["branch", "concept", "theorem", "problem", "method", "theory", "failure", "notation", "person", "text", "witness", "event", "teaching_point", "statement"] },
    "schema_version": { "const": "0.2" },
    "labels": { "$ref": "#/$defs/labels" },
    "status": { "enum": ["active", "historical", "superseded", "disputed", "open", "resolved", "partially_resolved", "reformulated", "abandoned", "proposed", "deprecated", "umbrella", "current", "contested", "misattributed"] },
    "summary": { "type": "string", "maxLength": 280 },
    "claims": { "type": "array", "minItems": 0, "items": { "$ref": "#/$defs/claim" } },
    "occurrences": { "type": "array", "items": { "$ref": "#/$defs/occurrence" } },
    "text_ref": { "type": ["string", "null"], "pattern": "^doc:.+#.+$" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "text_type": { "enum": ["original", "compilation", "commentary", "translation", "textbook", "article", "letter", "treatise", "standard", "manual", "errata", "release_note", "spec_change", "source_repository", "commit", "mailing_list"] },
    "witness_kind": { "enum": ["original", "copy", "critical_edition", "translation", "modern_collation", "excerpt", "reconstruction", "manuscript", "printed_edition", "web_snapshot", "commit"] },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "branch" } } }, "then": { "required": ["view_classes", "parents", "scope_definition", "affected_layers"] } },
    { "if": { "properties": { "type": { "const": "concept" } } }, "then": { "required": ["definition", "definition_source", "occurrences"] } },
    { "if": { "properties": { "type": { "const": "theorem" } } }, "then": { "required": ["statement", "assumptions", "proof_status"] } },
    { "if": { "properties": { "type": { "const": "problem" } } }, "then": { "required": ["original_formulation", "problem_kind", "asked_as", "status", "related_branches"] } },
    { "if": { "properties": { "type": { "const": "method" } } }, "then": { "required": ["kind", "input", "output"] } },
    { "if": { "properties": { "type": { "const": "theory" } } }, "then": { "required": ["assumptions", "core_concepts"] } },
    { "if": { "properties": { "type": { "const": "failure" } } }, "then": { "required": ["failure_kind", "target", "why_accepted", "current_status"] } },
    { "if": { "properties": { "type": { "const": "notation" } } }, "then": { "required": ["symbol_id", "kind", "denotation", "first_occurrence", "modern_standard"] } },
    { "if": { "properties": { "type": { "const": "person" } } }, "then": { "required": ["name_variants"] } },
    { "if": { "properties": { "type": { "const": "text" } } }, "then": { "required": ["title_variants", "text_type", "chains"] } },
    { "if": { "properties": { "type": { "const": "witness" } } }, "then": { "required": ["witness_kind", "extant", "date", "holding"] } },
    { "if": { "properties": { "type": { "const": "event" } } }, "then": { "required": ["date", "place", "actors"] } },
    { "if": { "properties": { "type": { "const": "teaching_point" } } }, "then": { "required": ["course", "chapter", "learning_objective", "history_objects", "evidence"] } },
    { "if": { "properties": { "type": { "const": "statement" } } }, "then": { "required": ["claim_text", "about", "stance", "status", "text_ref"] } }
  ],
  "$defs": {
    "labels": {
      "type": "object",
      "required": ["zh"],
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "statement", "grade", "attestation", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^CLM:[A-Za-z0-9:._-]+\\.[0-9]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "grade": { "enum": ["A", "S", "U", "F"] },
        "attestation": { "enum": ["direct", "contemporary_report", "later_report", "textbook_simplification", "unknown"] },
        "source": {
          "type": "object",
          "required": ["locator"],
          "properties": {
            "text": { "type": "string" },
            "witness": { "type": "string" },
            "locator": { "type": "string", "minLength": 1 },
            "url": { "type": "string" }
          }
        },
        "note": { "type": "string" },
        "supports": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "attestation": { "const": "textbook_simplification" } } },
          "then": { "properties": { "grade": { "enum": ["F", "U"] } } }
        },
        {
          "if": { "properties": { "attestation": { "const": "direct" } } },
          "then": { "properties": { "grade": { "enum": ["A", "S"] } } }
        }
      ]
    },
    "occurrence": {
      "type": "object",
      "required": ["civilization", "year_from", "precision", "independence"],
      "properties": {
        "civilization": { "type": "string" },
        "region": { "type": "string" },
        "language": { "type": "string" },
        "year_from": { "type": "integer" },
        "year_to": { "type": "integer" },
        "precision": { "enum": ["exact", "year", "decade", "century", "circa", "traditional"] },
        "dating_basis": { "type": "string" },
        "independence": { "enum": ["independent", "derived", "contested", "unknown"] },
        "independence_note": { "type": "string" },
        "claims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_by", "created_at", "schema_version"],
      "properties": {
        "created_by": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "review": { "enum": ["none", "internal", "second-person"] },
        "sources_checked": { "enum": ["none", "partial", "full"] },
        "schema_version": { "const": "0.2" }
      }
    }
  }
}
